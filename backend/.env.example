# SmartSupply — Variables de entorno
# Copiar este archivo a .env y completar con tus credenciales reales
# NUNCA subir el archivo .env al repositorio

# Base de datos PostgreSQL / Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/smartsupply
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key

# Configuración de la API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS — orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=ValorantryzenpeekMatiLocura
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
REGISTER_SECRET=codigo-que-compartes-con-tu-equipo

# Forecasting
FORECAST_MODEL_PATH=../forecasting/models
DEFAULT_HORIZON_DAYS=14
